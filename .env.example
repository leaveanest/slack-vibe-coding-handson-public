# =========================================================
# slack-vibe-coding-handson - root .env example
# =========================================================
# 各パターンディレクトリにも個別の .env.example があります。
# まずはルート直下の値をコピーして、必要に応じて各パターンの .env を別途用意してください。
#
#   cp .env.example .env
#

# --- Slack (Bolt 版で使用) ---
# https://api.slack.com/apps からアプリを作成して取得
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# --- Slack (Platform 版で使用) ---
# `slack login` で認証する場合は基本不要。プログラム側から API 呼び出す場合は使用。
# SLACK_API_TOKEN=xoxp-...

# --- OpenAI ---
# 当日配布、または https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
