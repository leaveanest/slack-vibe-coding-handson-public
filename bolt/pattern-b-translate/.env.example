# =========================================================
# bolt/pattern-b-translate/.env.example
# =========================================================
# このファイルを `.env` にコピーして値を埋めてください。
#   cp .env.example .env

# --- OpenAI ---
# 当日のメインフロー (`slack run`) では Slack Token は CLI が自動注入するので、
# .env に書く必要があるのは OPENAI_API_KEY だけです。
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- App ---
LOG_LEVEL=info

# =========================================================
# fallback: slack CLI が使えない場合のみ、以下のコメントを外して埋めてください。
# =========================================================
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-level-token
# SLACK_SIGNING_SECRET=your-signing-secret
