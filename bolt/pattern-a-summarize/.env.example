# =========================================================
# bolt/pattern-a-summarize/.env.example
# =========================================================
# このファイルを `.env` にコピーしてから値を埋めてください。
#   cp .env.example .env

# --- OpenAI ---
# 当日のメインフロー (`slack run`) では Slack Token は CLI が自動注入するので、
# .env に書く必要があるのは OPENAI_API_KEY だけです。
OPENAI_API_KEY=sk-your-openai-key

# モデル名はワークショップ当日告知。デフォルト gpt-4o-mini で十分。
OPENAI_MODEL=gpt-4o-mini

# --- App ---
LOG_LEVEL=info

# =========================================================
# fallback: slack CLI が使えない場合のみ、以下のコメントを外して埋めてください。
# (`slack install` + `slack run` を使う限りは不要)
# =========================================================
# SLACK_BOT_TOKEN=xoxb-your-bot-token             # OAuth & Permissions → Bot Token
# SLACK_APP_TOKEN=xapp-your-app-level-token       # Basic Information → App-Level Tokens (scope: connections:write)
# SLACK_SIGNING_SECRET=your-signing-secret        # Basic Information → App Credentials
