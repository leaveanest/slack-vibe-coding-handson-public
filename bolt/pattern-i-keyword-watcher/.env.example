# =========================================================
# bolt/pattern-i-keyword-watcher/.env.example
# =========================================================

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- 見守り設定 ---
# 監視するキーワード (カンマ区切り、case-insensitive)
WATCH_KEYWORDS=リリース,障害,緊急,deploy,outage

# キーワードヒット時に DM を送るユーザー ID (例: U01ABCDEF)
NOTIFY_USER_ID=U0000000000

# 前後コンテキストとして取得する履歴件数 (前/後それぞれ)
CONTEXT_BEFORE=5

# --- App ---
LOG_LEVEL=info
