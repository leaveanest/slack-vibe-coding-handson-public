# ---------------------------------------------------------------------------
# pattern-d-daily-report 用環境変数テンプレート
# ---------------------------------------------------------------------------
# このファイルを `.env` にコピーして値を埋めてください。
#
#   cp .env.example .env
#
# Slack Platform (Deno SDK) のローカル実行 `slack run` 時、env は
# 自動でランタイムに引き渡され、Custom Function 内では `env` から
# 参照できます (Deno.env.get() ではなく、ハンドラ引数の env を使うのが
# Slack Platform のお作法です)。
#
# 本番デプロイ時は `slack env add OPENAI_API_KEY sk-...` でクラウド側に
# 登録する必要があります (.env は使われません)。
# ---------------------------------------------------------------------------

# OpenAI の API キー。Codex CLI とは別に、Custom Function 内の
# fetch("https://api.openai.com/v1/chat/completions") で使用する。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意: 使用するモデル。未指定なら gpt-4o-mini にフォールバック。
# ハンズオンではコスト・スピード重視で gpt-4o-mini 推奨。
OPENAI_MODEL=gpt-4o-mini
